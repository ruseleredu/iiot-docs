# Copie para ".env" e ajuste.  (Windows: copy .env.example .env)

# Grupo do LAB IoT: define os tópicos MQTT (<grupo>/camara/...) e o nome do host (<grupo>-camara)
GRUPO=lab05-a

# Broker MQTT. Sozinho: o mosquitto do kit no próprio PC (host.docker.internal).
# Com docker-compose.lab.yml o simulador usa "mosquitto" na rede do lab.
MQTT_HOST=host.docker.internal
MQTT_PORT=1883

# Rede do kit/laboratório (só com docker-compose.lab.yml):
#   kit do aluno ......... lab05-a_labnet   (pasta do kit + "_labnet")
#   servidor do lab ...... lab05_labnet
LAB_REDE=lab05-a_labnet

# 1 = tempo real; 5 ou 10 aceleram a dinâmica térmica
SIM_SPEED=1

# Portas no PC (mude se já estiverem em uso, ex.: PORTA_S7=1102)
PORTA_MODBUS_TCP=502
PORTA_MODBUS_RTU=5021
PORTA_S7=102
PORTA_OPCUA=4840
