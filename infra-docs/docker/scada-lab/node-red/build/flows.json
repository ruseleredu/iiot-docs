  {
    "id":"normalize","type":"function","z":"tab1","name":"Normalizar","func":"const p=(msg.topic||'').split('/');\nconst v=Number(msg.payload);\nif(!Number.isFinite(v)) return null;\nmsg.device=p[1]||'unknown';\nmsg.variable=p[2]||'value';\nmsg.value=v;\nmsg.topic='INSERT INTO measurements (device, variable, value) VALUES ($device, $variable, $value)';\nmsg.params={$device:msg.device,$variable:msg.variable,$value:v};\nreturn msg;","outputs":1,"x":350,"y":100,"wires":[["sqlite1"]]
  },
